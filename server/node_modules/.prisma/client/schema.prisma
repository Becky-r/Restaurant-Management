generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id         String     @id @default(uuid())
  name       String
  orderIndex Int
  items      MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  image       String?
  isAvailable Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
}
